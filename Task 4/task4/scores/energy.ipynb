   "outputs": [],
   "source": [
    "def energy(z):\n",
    "    z=np.asarray(z,dtype=np.float64);m=z.max(1)\n",
    "    return -m-np.log(np.exp(z-m[:,None]).sum(1))"
   ],
   "id": "c7095e2da013"
