   "source": [
    "Larger means more unknown: 1 minus maximum softmax probability."
   ],
   "id": "7e09b185bc73"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "def msp(z):\n",
    "    z=np.asarray(z,dtype=np.float64);e=np.exp(z-z.max(1,keepdims=True))\n",
    "    return 1.-(e/e.sum(1,keepdims=True)).max(1)"
   ],
   "id": "bf7d5085cd78"
  }
