   "outputs": [],
   "source": [
    "def ordinary_loss(model,x,y):\n",
    "    _,z,_=forward_outputs(model,x)\n",
    "    loss=F.cross_entropy(z,y)\n",
    "    return loss,{'ce':loss.detach().item(),'correct':(z.argmax(1)==y).sum().item(),'count':len(y)}"
   ],
   "id": "4a0c8eb7a8a6"
  }
